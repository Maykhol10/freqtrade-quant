# ============================================================
#  Copia a .env  ->  cp .env.example .env   (chmod 600 .env)
#  .env ESTA EN .gitignore. Nunca lo subas al repo.
#  Freqtrade sobreescribe config.json con FREQTRADE__SECCION__CLAVE
# ============================================================

# ---------- Telegram (resumen diario y alertas) ----------
# 1) Habla con @BotFather -> /newbot -> copia el token
# 2) Habla con @userinfobot -> copia tu id numerico
FREQTRADE__TELEGRAM__TOKEN=
FREQTRADE__TELEGRAM__CHAT_ID=

# ---------- API server / FreqUI (solo loopback + tunel SSH) ----------
FREQTRADE__API_SERVER__USERNAME=freq
FREQTRADE__API_SERVER__PASSWORD=
# Genera con: openssl rand -hex 32
FREQTRADE__API_SERVER__JWT_SECRET_KEY=
FREQTRADE__API_SERVER__WS_TOKEN=

# ---------- Binance ----------
# DEJAR VACIO durante dry-run: no se necesitan claves para datos publicos.
# Al pasar a real: clave SOLO spot trading, SIN retiros, restringida por IP de la VM.
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=
